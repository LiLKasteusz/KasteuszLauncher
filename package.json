{
  "name": "kasteusz-launcher",
  "productName": "KasteuszLauncher",
  "desktopName": "kasteusz-launcher",
  "version": "2.5.3",
  "description": "Nowoczesny launcher Minecraft z obsługą kont Microsoft Premium, serwera lokalnego i skinów 3D",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron --no-sandbox .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --linux --x64",
    "publish:release": "npm run build:all && node scripts/upload-release.js",
    "release": "electron-builder --win --linux --publish always"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "kasteusz",
    "premium",
    "microsoft"
  ],
  "author": "Kasteusz",
  "license": "MIT",
  "homepage": "https://szkolnesmp.pl",
  "dependencies": {
    "@distube/ytdl-core": "^5.0.2",
    "adm-zip": "^0.5.16",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.11",
    "lucide": "^1.61.0",
    "minecraft-launcher-core": "^3.18.2",
    "play-dl": "^1.9.7",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "pl.szkolnesmp.kasteuszlauncher",
    "productName": "Kasteusz Launcher",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "LiLKasteusz",
        "repo": "KasteuszLauncher"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kasteusz Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "KasteuszLauncher-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Kasteusz",
      "artifactName": "KasteuszLauncher-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "KasteuszLauncher-${version}.AppImage"
    },
    "deb": {
      "artifactName": "KasteuszLauncher-${version}.deb"
    }
  }
}
